# ── Application ──
APP_ENV=development
LOG_LEVEL=INFO

# ── PostgreSQL (Application Database) ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_platform
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/rag_platform

# ── JWT Authentication ──
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Credential Encryption ──
ENCRYPTION_KEY=change-me-generate-with-python-c-from-cryptography.fernet-import-Fernet-print-Fernet.generate_key

# ── OpenAI / LLM ──
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Qdrant (Vector Store) ──
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── File Storage ──
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── Retrieval ──
RETRIEVAL_TOP_K=20
RERANK_TOP_K=6
RERANK_MMR_LAMBDA=0.5
CONTEXT_MAX_TOKENS=3000

# ── Conversation History ──
HISTORY_MAX_MESSAGES=12
HISTORY_MAX_TOKENS=2000
HISTORY_TTL_SECONDS=604800

# ── SQL Execution Safety ──
SQL_QUERY_TIMEOUT_SECONDS=30
SQL_MAX_RESULT_ROWS=1000
